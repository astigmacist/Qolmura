{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/admin",
      "destination": "https://qolmura-nqnd.vercel.app/admin/",
      "permanent": false
    },
    {
      "source": "/admin/",
      "destination": "https://qolmura-nqnd.vercel.app/admin/",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "https://qolmura-nqnd.vercel.app/admin/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
