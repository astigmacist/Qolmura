DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.qolmura.kz,.vercel.app
CORS_ALLOWED_ORIGINS=https://qolmura.kz
CSRF_TRUSTED_ORIGINS=https://qolmura.kz,https://*.vercel.app
DATABASE_URL=postgresql://qolmura:replace-me@host.example.com:5432/qolmura?sslmode=require
QOLMURA_ADMIN_USERNAME=admin
QOLMURA_ADMIN_EMAIL=admin@qolmura.kz
QOLMURA_ADMIN_PASSWORD=replace-with-a-strong-password
QOLMURA_PUBLIC_SITE_URL=https://qolmura.vercel.app
# Legacy split PostgreSQL variables are also supported:
POSTGRES_DB=qolmura
POSTGRES_USER=qolmura
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
